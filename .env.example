# Core Telegram configuration
# Telegram BotFather token – 필수. 런타임에서 node-telegram-bot-api가 이 토큰으로 폴링합니다.
TELEGRAM_BOT_TOKEN=123456:ABC-telegram-token-here
# 실제 봇 username(@ 제외). config에서 mismatch면 경고만 출력해서 디버깅에 도움.
BOT_USERNAME=my_bot_username

# Admin & whitelist controls (optional)
# 화이트리스트 관리 명령을 허용할 Telegram 사용자 ID (정수). 비워두면 /whitelist_* 사용 불가.
ADMIN_USER_ID=123456789
# 관리자 그룹 ID (음수). 여기서만 /whitelist_* 명령을 허용하고 상태 알림도 이 방에 전송.
ADMIN_GROUP_ID=-1001234567890
# 초기 화이트리스트에 강제로 추가할 챗 ID 목록(쉼표 구분). 마이그레이션/부트스트랩용.
ALLOWED_CHAT_IDS=-1002345678901,-1003456789012

# Cerebras AI classification
# Cerebras Cloud API 키. 미입력 시 classify 호출 자체가 실패하므로 필수.
CEREBRAS_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXX
# 사용할 모델 ID. 기본값은 gpt-oss-120b 이지만 원하는 모델명으로 변경 가능.
CEREBRAS_MODEL=gpt-oss-120b

# Logging & storage
# tracing 기본 레벨(info/debug/warn 등).
LOG_LEVEL=info
# 로그 파일을 저장할 디렉터리. 존재하지 않으면 부팅 시 생성.
LOGS_DIR=logs
# SQLite 및 기타 데이터 파일을 둘 루트 디렉터리.
DATA_DIR=data
# SQLite 화이트리스트 DB 파일명. dataDir와 조합되어 경로가 결정됨.
DB_FILENAME=whitelist.db

# Web content analysis
# 메시지당 최대 URL fetch 개수 (AI 프롬프트에 넣을 외부 페이지 수 제한).
MAX_URLS_PER_MESSAGE=2
# 단일 URL fetch 타임아웃(ms). 너무 낮추면 느린 페이지는 분석되지 않음.
WEBPAGE_FETCH_TIMEOUT=10000
# dom_smoothie가 뽑은 본문 텍스트를 자를 최대 길이.
WEBPAGE_CONTENT_MAX_LENGTH=1000
# 외부 웹페이지 응답 본문을 읽을 최대 크기(bytes).
WEBPAGE_RESPONSE_MAX_BYTES=1048576

# Queue limits
# 전체 처리 대기열 최대 메시지 수.
QUEUE_MAX_MESSAGES=5000
# 높은 우선순위 대기열 최대 메시지 수.
QUEUE_HIGH_PRIORITY_MAX=1000
# 일반 우선순위 대기열 최대 메시지 수.
QUEUE_NORMAL_PRIORITY_MAX=4000

# Spam cache
# 이전에 삭제된 스팸 메시지와 유사하면 LLM 호출 없이 삭제할 유사도 임계값(0.0~1.0).
SPAM_CACHE_SIMILARITY_THRESHOLD=0.92
# 유사도 비교 시 최근 스팸 캐시 후보를 가져올 최대 개수.
SPAM_CACHE_SCAN_LIMIT=1000
# 너무 짧은 메시지를 캐시 비교/등록에서 제외할 정규화 문자 수.
SPAM_CACHE_MIN_NORMALIZED_CHARS=8

# Scheduler / timezone
# 관리자 알림, 재부팅 스케줄 등에 사용되는 기준 타임존.
BOT_TIMEZONE=Asia/Seoul
# tokio-cron-scheduler에 넘길 크론 문자열들(세미콜론 구분). 기본은 자정/정오 재시작.
# 형식: 초 분 시 일 월 요일 (0-6, 0=일요일)
RESTART_CRONS=0 0 0 * * *;0 0 12 * * *

# Runtime environment
# Rust 프로세스 내부에서 사용하는 환경 태그. 현재 코드에서는 informational logging에만 사용.
NODE_ENV=production

# Auto update (optional)
# GitHub release를 주기적으로 확인해 최신 바이너리를 자동 적용하려면 true.
AUTO_UPDATE_ENABLED=false
# 프로세스 시작 시 즉시 업데이트 체크를 수행할지 여부.
AUTO_UPDATE_CHECK_ON_STARTUP=true
# 새 바이너리를 설치한 뒤 즉시 재시작(exec)할지 여부.
AUTO_UPDATE_AUTO_RESTART=true
# 릴리스가 호스팅된 GitHub 저장소 (owner / repo). 기본값은 본 프로젝트 origin.
AUTO_UPDATE_REPO_OWNER=yldst-dev
AUTO_UPDATE_REPO_NAME=fuckyou-spam-rs
# 자동 업데이트를 허용할 GitHub 저장소 owner/name 목록(쉼표 구분). 위 저장소가 목록에 없으면 중단.
AUTO_UPDATE_ALLOWED_REPO_OWNERS=yldst-dev
AUTO_UPDATE_ALLOWED_REPO_NAMES=fuckyou-spam-rs
# 릴리스 asset 및 체크섬 다운로드를 허용할 정확한 HTTPS host 목록(쉼표 구분).
AUTO_UPDATE_ASSET_HOST_ALLOWLIST=github.com,objects.githubusercontent.com,github-releases.githubusercontent.com
# 릴리스 asset 최대 다운로드 크기(bytes).
AUTO_UPDATE_MAX_DOWNLOAD_BYTES=52428800
# 고정 SHA-256 값. 비워두면 같은 릴리스의 <asset>.sha256 asset을 요구.
AUTO_UPDATE_ASSET_SHA256=
